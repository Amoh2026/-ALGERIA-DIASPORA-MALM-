# VITE - Frontend
VITE_API_URL=https://localhost:5001
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_HYGRAPH_ENDPOINT=your_hygraph_endpoint
VITE_HYGRAPH_API_KEY=your_hygraph_api_key

# ASP.NET Core - Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Database=algeria_diaspora_malmo;Username=postgres;Password=yourpassword

# JWT Settings
JwtSettings__Secret=your_super_secret_key_minimum_32_characters
JwtSettings__Issuer=https://localhost:5001
JwtSettings__Audience=https://localhost:5173
JwtSettings__ExpiryMinutes=60

# Email (Resend)
EmailSettings__ApiKey=re_your_resend_api_key
EmailSettings__FromEmail=noreply@algeriadiaspora.com
EmailSettings__FromName=Algeria Diaspora Malmö

# Cloudflare
Cloudflare__AccountId=your_account_id
Cloudflare__ApiToken=your_api_token
Cloudflare__R2Bucket=algeria-diaspora-assets
